#include <windows.h>
#include "Resource.h"

// Icon
IDI_QUICKFOLDER ICON "QuickFolder.ico"

// Manifest
1 24 "QuickFolder.exe.manifest"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "QuickFolder Open Source Project"
            VALUE "FileDescription",  "QuickFolder Windows Shell Utility"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "QuickFolder"
            VALUE "LegalCopyright",   "Copyright (C) 2026 QuickFolder Contributors (MIT License)"
            VALUE "OriginalFilename", "QuickFolder.exe"
            VALUE "ProductName",      "QuickFolder"
            VALUE "ProductVersion",   "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
